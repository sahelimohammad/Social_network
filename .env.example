# Copy to .env and replace the secret key with a unique generated value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional Gmail SMTP settings for password-reset emails.
# If left empty, Django prints messages to the console in development.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
